# Copy this file to .env for local development.
# Get this connection string from your Neon (or Supabase) project dashboard.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random string. Signs the sign-in session, so keep it secret.
# Left as "change-me" or empty, a random key is used and sign-ins reset on restart.
SECRET_KEY=change-me

# The ID and password for the sign-in page. Both must be set, or nobody can sign in.
APP_USERNAME=your-id
APP_PASSWORD=your-password
